# Modo de operación: "mock" usa datos y WebSocket simulados; "live" conecta al orquestador real.
NEXT_PUBLIC_ARGUS_MODE=live

# Endpoint HTTP del orquestador (solo se usa en modo live)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canal de eventos en tiempo real (solo se usa en modo live)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Versión mostrada en la barra superior
NEXT_PUBLIC_APP_VERSION=v1.0.0
